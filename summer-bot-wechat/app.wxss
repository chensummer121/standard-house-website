/* Summer Bot 全局样式 - Power BI 深色主题 */

page {
  --bg-primary: #0f172a;
  --bg-secondary: #1e293b;
  --bg-card: rgba(30, 41, 59, 0.8);
  --border-color: rgba(100, 116, 139, 0.2);
  --text-primary: #e2e8f0;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --accent-gold: #F59E0B;
  --accent-gold-dark: #D97706;
  --accent-blue: #38bdf8;
  --accent-cyan: #0ea5e9;
  --success: #22c55e;
  --warning: #eab308;
  --danger: #ef4444;
  
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  font-weight: 400;
}

view, text, scroll-view {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.gradient-text {
  background: linear-gradient(135deg, var(--accent-blue), var(--accent-cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.btn-gold {
  background: linear-gradient(135deg, var(--accent-gold), var(--accent-gold-dark));
  color: #fff;
  border: none;
  font-weight: 600;
  border-radius: 24rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

.btn-gold::after { border: none; }
.btn-gold:active { opacity: 0.9; transform: scale(0.98); }

.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 24rpx;
}

.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.animate-fade-in { animation: fadeIn 0.3s ease-out; }
.animate-pulse { animation: pulse 1.5s ease-in-out infinite; }

.loading-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.loading-dots view {
  width: 12rpx;
  height: 12rpx;
  background: var(--accent-gold);
  border-radius: 50%;
  animation: pulse 1.4s ease-in-out infinite;
}

.loading-dots view:nth-child(2) { animation-delay: 0.2s; }
.loading-dots view:nth-child(3) { animation-delay: 0.4s; }

.tag-public { background: rgba(34, 197, 94, 0.2); color: var(--success); font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.tag-internal { background: rgba(234, 179, 8, 0.2); color: var(--warning); font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.tag-confidential { background: rgba(100, 116, 139, 0.2); color: var(--text-muted); font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }

::-webkit-scrollbar { width: 0; height: 0; color: transparent; }

.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }
.gap-sm { gap: 12rpx; }
.gap-md { gap: 24rpx; }
.gap-lg { gap: 32rpx; }

.text-center { text-align: center; }
.text-gold { color: var(--accent-gold); }
.text-blue { color: var(--accent-blue); }
.text-muted { color: var(--text-muted); }
.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
