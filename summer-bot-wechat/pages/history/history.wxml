<!-- pages/history/history.wxml -->
<!-- Summer Bot 历史记录页面 -->

<view class="container">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-left" bindtap="onClearAll">
      <text class="nav-icon">🗑️</text>
      <text class="nav-text">清空</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">聊天历史</text>
    </view>
    <view class="nav-right"></view>
  </view>

  <!-- 内容区 -->
  <scroll-view
    class="content"
    scroll-y
    enhanced
    bounces
  >
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{isEmpty && !isLoading}}">
      <text class="empty-icon">📭</text>
      <text class="empty-title">暂无历史记录</text>
      <text class="empty-desc">开始对话后，记录将显示在这里</text>
      <view class="empty-btn" bindtap="onStartChat">
        <text>开始对话</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{isLoading}}">
      <view class="loading-dots">
        <view></view>
        <view></view>
        <view></view>
      </view>
    </view>

    <!-- 分组会话列表 -->
    <view class="session-groups" wx:if="{{!isEmpty && !isLoading}}">
      <block wx:for="{{groupedSessions}}" wx:for-item="group" wx:key="title">
        <view class="group">
          <view class="group-title">
            <text>{{group.title}}</text>
          </view>
          <view class="group-sessions">
            <block wx:for="{{group.sessions}}" wx:for-item="session" wx:key="sessionId">
              <view 
                class="session-item"
                bindtap="onSessionTap"
                data-sessionid="{{session.sessionId}}"
              >
                <view class="session-content">
                  <view class="session-title">
                    <text class="session-icon">💬</text>
                    <text class="session-name">{{session.title}}</text>
                  </view>
                  <text class="session-preview">{{session.lastMessage}}</text>
                </view>
                <view class="session-meta">
                  <text class="session-time">{{formatTime(session.updatedAt)}}</text>
                  <view 
                    class="delete-btn"
                    catchtap="onSessionDelete"
                    data-sessionid="{{session.sessionId}}"
                    data-index="{{index}}"
                  >
                    <text>✕</text>
                  </view>
                </view>
              </view>
            </block>
          </view>
        </view>
      </block>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>
  </scroll-view>
</view>
