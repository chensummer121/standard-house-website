/* pages/history/history.wxss */
/* Summer Bot 历史记录页面样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-primary);
}

/* ========== 导航栏 ========== */
.nav-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-top: calc(20rpx + constant(safe-area-inset-top));
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border-color);
}

.nav-left, .nav-right {
  flex: 0 0 120rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nav-right {
  justify-content: flex-end;
}

.nav-left:active {
  opacity: 0.7;
}

.nav-icon {
  font-size: 32rpx;
}

.nav-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.nav-center {
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ========== 内容区 ========== */
.content {
  flex: 1;
  overflow-y: auto;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-muted);
  text-align: center;
  margin-bottom: 60rpx;
}

.empty-btn {
  padding: 24rpx 60rpx;
  background: linear-gradient(135deg, var(--accent-gold), var(--accent-gold-dark));
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.empty-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* ========== 加载状态 ========== */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx;
}

.loading-dots {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loading-dots view {
  width: 16rpx;
  height: 16rpx;
  background: var(--accent-gold);
  border-radius: 50%;
  animation: pulse 1.4s ease-in-out infinite;
}

.loading-dots view:nth-child(2) { animation-delay: 0.2s; }
.loading-dots view:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

/* ========== 会话分组 ========== */
.session-groups {
  padding: 24rpx;
}

.group {
  margin-bottom: 40rpx;
}

.group:last-child {
  margin-bottom: 0;
}

.group-title {
  font-size: 26rpx;
  color: var(--text-muted);
  font-weight: 500;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.group-sessions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ========== 会话项 ========== */
.session-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.2s ease;
}

.session-item:active {
  background: rgba(30, 41, 59, 0.6);
}

.session-content {
  flex: 1;
  min-width: 0;
}

.session-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.session-icon {
  font-size: 32rpx;
}

.session-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.session-preview {
  font-size: 26rpx;
  color: var(--text-muted);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
}

.session-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  margin-left: 24rpx;
}

.session-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.delete-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 50%;
  font-size: 20rpx;
  color: var(--danger);
}

.delete-btn:active {
  background: rgba(239, 68, 68, 0.2);
}

/* ========== 底部占位 ========== */
.bottom-placeholder {
  height: 60rpx;
}
