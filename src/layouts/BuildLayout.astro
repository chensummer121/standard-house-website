---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "PropTech housing innovator in Uganda. Prefabricated homes with transparent pricing and guaranteed timelines." } = Astro.props;

const navigation = [
  { name: "Home", href: "/" },
  { name: "House Designs", href: "/house-designs" },
  { name: "Configurator", href: "/configurator" },
  { name: "Projects", href: "/projects" },
  { name: "Investment", href: "/investment" },
  { name: "About Us", href: "/about" },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Standard House Uganda</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '#F59E0B',
              earth: {
                50: '#faf9f7',
                100: '#f5f3ef',
                200: '#e8e4dc',
                300: '#d4cec2',
                400: '#b8ae9c',
                500: '#9c8f78',
                600: '#847560',
                700: '#6c5f4d',
                800: '#4a4235',
                900: '#2d271f',
              },
              sage: {
                50: '#f4f7f5',
                100: '#e3ebe5',
                200: '#c8d7cb',
                300: '#a3b9a6',
                400: '#7a9680',
                500: '#5a7861',
                600: '#44604c',
                700: '#374e3e',
                800: '#2d4033',
                900: '#263529',
              },
            },
          },
        },
      }
    </script>
    <style>
      body { font-family: 'Inter', sans-serif; }
    </style>
  </head>
  <body class="bg-white text-earth-800">
    <!-- Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm shadow-sm">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 md:h-20">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-2">
            <img src="/logo.png" alt="Standard House" class="h-10 w-auto" />
            <div>
              <span class="text-xl font-bold text-earth-800">Standard</span>
              <span class="text-xl font-bold text-primary"> House</span>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <div class="hidden lg:flex items-center gap-1">
            {navigation.map((item) => (
              <a
                href={item.href}
                class="px-4 py-2 text-sm font-medium text-earth-700 hover:text-primary transition-colors rounded-lg hover:bg-earth-50"
              >
                {item.name}
              </a>
            ))}
          </div>

          <!-- Desktop CTA -->
          <div class="hidden lg:flex items-center gap-4">
            <a href="/configurator" class="inline-flex items-center justify-center px-5 py-2.5 bg-primary text-white text-sm font-medium rounded-lg hover:bg-amber-600 transition-colors">
              Start Building
            </a>
          </div>

          <!-- Mobile menu button -->
          <button
            type="button"
            id="mobile-menu-btn"
            class="lg:hidden p-2 text-earth-700"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="hidden lg:hidden">
          <div class="py-4 space-y-1 border-t border-earth-200">
            {navigation.map((item) => (
              <a
                href={item.href}
                class="flex items-center gap-3 px-4 py-3 text-base font-medium text-earth-700 hover:text-primary hover:bg-earth-50 rounded-lg transition-colors"
              >
                {item.name}
              </a>
            ))}
            <div class="pt-4 px-4">
              <a href="/configurator" class="block w-full text-center px-5 py-2.5 bg-primary text-white text-sm font-medium rounded-lg hover:bg-amber-600 transition-colors">
                Start Building
              </a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="pt-16 md:pt-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-earth-900 text-earth-100">
      <!-- Main Footer -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12">
          <!-- Brand -->
          <div class="lg:col-span-2">
            <a href="/" class="flex items-center gap-2 mb-6">
              <div class="w-10 h-10 bg-gradient-to-br from-primary to-earth-600 rounded-lg flex items-center justify-center">
                <img src="/logo.png" alt="SH" class="h-8 w-auto" />
              </div>
              <div>
                <span class="text-xl font-bold text-white">Standard</span>
                <span class="text-xl font-bold text-primary"> House</span>
              </div>
            </a>
            <p class="text-earth-300 mb-6 max-w-md">
              PropTech housing innovator in Uganda. Prefabricated homes with transparent pricing and guaranteed timelines.
            </p>
            <div class="space-y-3">
              <div class="flex items-center gap-3 text-earth-300">
                <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>6th Street, Industrial Area, Kampala, Uganda</span>
              </div>
              <a href="https://wa.me/256766969867" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-earth-300 hover:text-primary transition-colors">
                <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                <span>+256 766 969 867 (WhatsApp)</span>
              </a>
              <a href="mailto:standradhouseug@standard-house.com" class="flex items-center gap-3 text-earth-300 hover:text-primary transition-colors">
                <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span>standradhouseug@standard-house.com</span>
              </a>
            </div>
          </div>

          <!-- Explore Links -->
          <div>
            <h3 class="text-white font-semibold mb-4">Explore</h3>
            <ul class="space-y-3">
              <li><a href="/house-designs" class="text-earth-300 hover:text-primary transition-colors">House Designs</a></li>
              <li><a href="/configurator" class="text-earth-300 hover:text-primary transition-colors">Configurator</a></li>
              <li><a href="/projects" class="text-earth-300 hover:text-primary transition-colors">Gallery</a></li>
              <li><a href="/investment" class="text-earth-300 hover:text-primary transition-colors">Investment</a></li>
            </ul>
          </div>

          <!-- Company Links -->
          <div>
            <h3 class="text-white font-semibold mb-4">Company</h3>
            <ul class="space-y-3">
              <li><a href="/about" class="text-earth-300 hover:text-primary transition-colors">About Us</a></li>
              <li><a href="/about#team" class="text-earth-300 hover:text-primary transition-colors">Our Team</a></li>
              <li><a href="/about#contact" class="text-earth-300 hover:text-primary transition-colors">Contact</a></li>
              <li><a href="/careers" class="text-earth-300 hover:text-primary transition-colors">Careers</a></li>
            </ul>
          </div>

          <!-- Resources Links -->
          <div>
            <h3 class="text-white font-semibold mb-4">Resources</h3>
            <ul class="space-y-3">
              <li><a href="/blog" class="text-earth-300 hover:text-primary transition-colors">Blog</a></li>
              <li><a href="/faq" class="text-earth-300 hover:text-primary transition-colors">FAQ</a></li>
              <li><a href="/support" class="text-earth-300 hover:text-primary transition-colors">Support</a></li>
              <li><a href="/privacy" class="text-earth-300 hover:text-primary transition-colors">Privacy Policy</a></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="border-t border-earth-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
          <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-earth-400 text-sm">
              © {new Date().getFullYear()} Standard House. All rights reserved.
            </p>
            <div class="flex items-center gap-4">
              <a href="https://wa.me/256766969867" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-earth-800 flex items-center justify-center text-earth-300 hover:bg-primary hover:text-white transition-colors" aria-label="WhatsApp">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              </a>
              <a href="https://www.facebook.com/profile.php?id=100093405760075" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-earth-800 flex items-center justify-center text-earth-300 hover:bg-primary hover:text-white transition-colors" aria-label="Facebook">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-earth-800 flex items-center justify-center text-earth-300 hover:bg-primary hover:text-white transition-colors" aria-label="Instagram">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-earth-800 flex items-center justify-center text-earth-300 hover:bg-primary hover:text-white transition-colors" aria-label="LinkedIn">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Script -->
    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }
    </script>

    <!-- WhatsApp Button -->
    <a href="https://wa.me/256766969867" target="_blank" rel="noopener noreferrer" class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-green-500 rounded-full flex items-center justify-center shadow-lg hover:bg-green-600 transition-colors">
      <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </body>
</html>
