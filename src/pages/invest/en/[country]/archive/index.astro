---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Sidebar from '@components/Sidebar.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { country: 'ethiopia' } },
    { params: { country: 'uganda' } },
    { params: { country: 'kenya' } },
    { params: { country: 'tanzania' } },
    { params: { country: 'rwanda' } },
    { params: { country: 'south-sudan' } },
  ];
}

const { country } = Astro.params;
const currentPath = Astro.url.pathname;

const countryNames = {
  ethiopia: 'Ethiopia',
  uganda: 'Uganda',
  kenya: 'Kenya'
};

// Get archive documents for this country
const docs = await getCollection('countries', ({ id }) => 
  id.startsWith(`${country}/archive/`)
);

// Sort by title
docs.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={`Archive - ${countryNames[country]}`}>
  <Header country={country} />
  
  <div class="flex">
    <Sidebar currentPath={currentPath} country={country} />
    
    <main class="flex-1 p-6 max-w-5xl">
      <Breadcrumb items={[{ name: countryNames[country], href: `/invest/en/${country}` }, { name: 'Archive' }]} />
      
      <div class="mb-8">
        <h1 class="text-2xl font-bold mb-2">📚 Archive</h1>
        <p class="text-sm" style="color: var(--text-secondary)">Original research reports and documents for {countryNames[country]}</p>
      </div>

      <div class="space-y-4">
        {docs.length > 0 ? (
          docs.map(doc => (
            <a 
              href={`/invest/en/${country}/archive/${doc.id.split('/').pop()}`}
              class="group block p-6 rounded-xl transition-all hover:scale-[1.01]"
              style="background: var(--bg-card); border: 1px solid var(--border-color);"
            >
              <div class="flex items-start space-x-4">
                <div 
                  class="w-12 h-12 rounded-lg flex items-center justify-center text-xl flex-shrink-0"
                  style="background: rgba(68, 138, 255, 0.2);"
                >
                  📄
                </div>
                <div class="flex-1">
                  <h2 class="text-lg font-bold mb-1 group-hover:underline" style="color: var(--text-primary);">
                    {doc.data.title}
                  </h2>
                  <p class="text-sm" style="color: var(--text-secondary);">
                    {doc.data.section} / {doc.data.subsection}
                  </p>
                </div>
                <svg class="w-5 h-5 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--accent-blue);">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          ))
        ) : (
          <div class="text-center py-12" style="color: var(--text-secondary);">
            <p class="text-4xl mb-4">📭</p>
            <p>No reports available yet</p>
          </div>
        )}
      </div>
    </main>
  </div>
</BaseLayout>
