---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Sidebar from '../../../../components/Sidebar.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';

export function getStaticPaths() {
  return [
    { params: { country: 'ethiopia' } },
    { params: { country: 'uganda' } },
    { params: { country: 'kenya' } },
    { params: { country: 'tanzania' } },
    { params: { country: 'rwanda' } },
    { params: { country: 'south-sudan' } },
  ];
}

const { country } = Astro.params;
const currentPath = Astro.url.pathname;

const countryNames = {
  ethiopia: '埃塞俄比亚',
  uganda: '乌干达',
  kenya: '肯尼亚'
};

const items = [
  {
    title: '底层数据',
    desc: '宏观经济、人口、基础设施的实时面板',
    icon: '📊',
    href: `/invest/${country}/insight/data-panels`,
    color: '#3b82f6'
  },
  {
    title: '国家凭什么存在',
    desc: '地缘战略、历史定位、核心竞争优势',
    icon: '🌍',
    href: `/invest/${country}/insight/why-exist`,
    color: '#10b981'
  },
  {
    title: '谁在管这个国家',
    desc: '政治结构、权力格局、关键人物',
    icon: '🏛️',
    href: `/invest/${country}/insight/power-structure`,
    color: '#f59e0b'
  },
  {
    title: '钱从哪来到哪去',
    desc: '财政、贸易、资金流动深度分析',
    icon: '💰',
    href: `/invest/${country}/insight/money-flow`,
    color: '#ef4444'
  },
  {
    title: '社会怎么兜底',
    desc: '民生状况、安全网体系、社会问题',
    icon: '👥',
    href: `/invest/${country}/insight/social-safety`,
    color: '#8b5cf6'
  },
  {
    title: '结构性变化',
    desc: '正在发生的大趋势和转型',
    icon: '📈',
    href: `/invest/${country}/insight/structural-change`,
    color: '#ec4899'
  },
];
---

<BaseLayout title={`国家透视 - ${countryNames[country]}`}>
  <Header country={country} />
  
  <div class="flex">
    <Sidebar currentPath={currentPath} country={country} />
    
    <main class="flex-1 p-6 max-w-5xl">
      <Breadcrumb items={[{ name: countryNames[country], href: `/invest/${country}` }, { name: '国家透视' }]} />
      
      <div class="mb-8">
        <h1 class="text-2xl font-bold mb-2">🔍 国家透视</h1>
        <p class="text-sm" style="color: var(--text-secondary)">深度理解{countryNames[country]}运转的底层逻辑</p>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        {items.map(item => (
          <a 
            href={item.href} 
            class="group block p-6 rounded-xl transition-all hover:scale-[1.02] hover:-translate-y-1"
            style="background: var(--bg-card); border: 1px solid var(--border-color);"
          >
            <div class="flex items-start space-x-4">
              <div 
                class="w-14 h-14 rounded-xl flex items-center justify-center text-2xl flex-shrink-0"
                style={`background: ${item.color}20;`}
              >
                {item.icon}
              </div>
              <div class="flex-1">
                <h2 class="text-lg font-bold mb-1 group-hover:underline" style="color: var(--text-primary);">
                  {item.title}
                </h2>
                <p class="text-sm" style="color: var(--text-secondary);">{item.desc}</p>
              </div>
              <svg class="w-5 h-5 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--accent-blue);">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
