  { value: '7', label: '关系维度', suffix: '维' },
];

function getRiskColor(score: number): string {
  if (score <= 4) return '#10b981';
  if (score <= 5.5) return '#F59E0B';
  return '#ef4444';
}

function getRiskBg(score: number): string {
  if (score <= 4) return 'rgba(16, 185, 129, 0.15)';
  if (score <= 5.5) return 'rgba(245, 158, 11, 0.15)';
  return 'rgba(239, 68, 68, 0.15)';
}
---

<IntelLayout title="东非投资情报站 - STANDERRA Intelligence">
  <style>
    .gradient-text {
      background: linear-gradient(135deg, #38bdf8, #0ea5e9);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .gradient-text-gold {
      background: linear-gradient(135deg, #F59E0B, #D97706);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-grid-bg {
      background-image: 
        linear-gradient(rgba(56, 189, 248, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(56, 189, 248, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    .card-hover {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card-hover:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(56, 189, 248, 0.08);
    }

    .btn-gold {
      background: linear-gradient(135deg, #F59E0B, #D97706);
      transition: all 0.3s ease;
    }
    .btn-gold:hover {
      background: linear-gradient(135deg, #FBBF24, #F59E0B);
      box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
      transform: translateY(-2px);
    }

    .btn-pill {
      border-radius: 9999px;
    }

    .entry-card {
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid rgba(56, 189, 248, 0.12);
      backdrop-filter: blur(12px);
      transition: all 0.3s ease;
    }
    .entry-card:hover {
      border-color: rgba(56, 189, 248, 0.35);
      background: rgba(30, 41, 59, 0.95);
    }
    .entry-card:hover .entry-icon {
      transform: scale(1.1);
    }

    .entry-icon {
      transition: transform 0.3s ease;
    }

    .country-card {
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid rgba(56, 189, 248, 0.1);
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
    }
    .country-card:hover {
      border-color: rgba(56, 189, 248, 0.35);
      background: rgba(30, 41, 59, 0.95);
    }

    .ai-box {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
      border: 1px solid rgba(56, 189, 248, 0.2);
    }

    .ai-quick-btn {
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.2);
      transition: all 0.2s ease;
    }
    .ai-quick-btn:hover {
      background: rgba(56, 189, 248, 0.2);
      border-color: rgba(56, 189, 248, 0.5);
      color: #38bdf8;
    }

    .industry-chip {
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid rgba(148, 163, 184, 0.1);
      transition: all 0.2s ease;
    }
    .industry-chip:hover {
      border-color: rgba(56, 189, 248, 0.4);
      background: rgba(56, 189, 248, 0.1);
      transform: translateY(-2px);
    }

    .stat-card {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.9));
      border: 1px solid rgba(56, 189, 248, 0.12);
    }

    .risk-bar {
      height: 6px;
      border-radius: 3px;
      background: rgba(255,255,255,0.1);
      overflow: hidden;
    }
    .risk-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 0.8s ease;
    }
  </style>

  <!-- ====== Hero 区域 ====== -->
  <section class="hero-grid-bg relative pt-28 pb-20 px-6 overflow-hidden">
    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-sky-500/8 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-blue-500/8 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8" style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.2);">
        <span class="text-sky-400 text-sm font-medium">🗺️ 覆盖东非十一国</span>
        <span class="text-slate-500 text-sm">|</span>
        <span class="text-slate-400 text-sm">覆盖 乌干达 · 埃塞俄比亚 · 肯尼亚 · 坦桑尼亚 · 卢旺达</span>
      </div>

      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        <span class="gradient-text">东非投资情报站</span>
      </h1>
      
      <p class="text-xl md:text-2xl text-slate-300 mb-4 font-medium">
        为中资出海决策者打造的结构化情报平台
      </p>
      <p class="text-base text-slate-500 mb-12 max-w-2xl mx-auto">
        从宏观政策到落地成本，从风险量化到审批流程——一站式获取可操作的投资情报
      </p>

      <!-- 数据底座统计 -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto mb-12">
        {stats.map(stat => (
          <div class="stat-card rounded-xl p-4 text-center">
            <div class="text-3xl font-bold text-white mb-1">
              <span class="text-sky-400">{stat.value}</span><span class="text-slate-400 text-lg">{stat.suffix}</span>
            </div>
            <div class="text-slate-500 text-sm">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== 四大入口卡片 ====== -->
  <section class="py-16 px-6" style="background: rgba(15, 23, 42, 0.5);">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-3">
          <span class="gradient-text">选择一个任务，立即开始</span>
        </h2>
        <p class="text-slate-400">不读文章，直接做决策</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {entryCards.map(card => (
          <a href={card.href} class="entry-card rounded-2xl p-6 card-hover block group">
            <div class="entry-icon text-5xl mb-4">{card.icon}</div>
            <div class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-3" style={`background: ${card.accent}22; border: 1px solid ${card.accent}44; color: ${card.accent};`}>
              {card.title}
            </div>
            <h3 class="text-xl font-bold text-white mb-2 whitespace-pre-line">{card.subtitle}</h3>
            <p class="text-slate-400 text-sm mb-5 leading-relaxed">{card.desc}</p>
            <div class="inline-flex items-center gap-2 font-bold text-sm" style={`color: ${card.accent};`}>
              <span>{card.cta}</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== 十一国速览面板 ====== -->
  <section class="py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-3xl font-bold mb-2">
            <span class="gradient-text">十一国数据速览</span>
          </h2>
          <p class="text-slate-400 text-sm">核心指标对比，数据来源：World Bank / IMF / 各央行（2024）</p>
        </div>
        <a href="/intel/compare/" class="hidden md:inline-flex items-center gap-2 text-sky-400 hover:text-sky-300 text-sm font-medium transition-colors">
          查看完整分析 →
        </a>
      </div>

      <!-- 桌面端：横向对比表 -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr style="border-bottom: 2px solid rgba(56, 189, 248, 0.2);">
              <th class="text-left py-3 px-4 text-slate-400 font-medium w-24">国家</th>
              <th class="text-center py-3 px-3 text-slate-400 font-medium">GDP</th>
              <th class="text-center py-3 px-3 text-slate-400 font-medium">增速</th>
              <th class="text-center py-3 px-3 text-slate-400 font-medium">人口</th>
              <th class="text-center py-3 px-3 text-slate-400 font-medium">城市化</th>
              <th class="text-center py-3 px-3 text-slate-400 font-medium">营商排名</th>
              <th class="text-center py-3 px-3 text-slate-400 font-medium">电气化率</th>
              <th class="text-center py-3 px-3 text-slate-400 font-medium w-36">风险评分</th>
              <th class="text-left py-3 px-3 text-slate-400 font-medium">适合行业</th>
            </tr>
          </thead>
          <tbody>
            {countries.map((c) => {
              const riskPct = Math.min(c.riskScore / 10 * 100, 100);
              return (
                <tr class="border-b border-slate-800/50 hover:bg-slate-800/30 transition-colors" style="border-bottom: 1px solid rgba(30, 41, 59, 0.8);">
                  <td class="py-4 px-4">
                    <a href={c.href} class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                      <span class="text-2xl">{c.flag}</span>
                      <span class="font-bold text-white">{c.name}</span>
                    </a>
                  </td>
                  <td class="text-center py-4 px-3">
                    <div class="font-bold text-white">{c.gdp}</div>
                    <div class="text-slate-500 text-xs">{c.gdpUnit}</div>
                  </td>
                  <td class="text-center py-4 px-3">
                    <span class="text-emerald-400 font-semibold">{c.gdpGrowth}</span>
                  </td>
                  <td class="text-center py-4 px-3 text-slate-300">{c.pop}</td>
                  <td class="text-center py-4 px-3 text-slate-400">{c.urban}</td>
                  <td class="text-center py-4 px-3">
                    <span class={`font-bold ${c.bizRank <= 50 ? 'text-emerald-400' : c.bizRank <= 100 ? 'text-amber-400' : 'text-red-400'}`}>
                      #{c.bizRank}
                    </span>
                  </td>
                  <td class="text-center py-4 px-3 text-slate-400">{c.elecRate}</td>
                  <td class="py-4 px-3">
                    <div class="flex items-center gap-3">
                      <div class="risk-bar flex-1">
                        <div class="risk-fill" style={`width: ${riskPct}%; background: ${getRiskColor(c.riskScore)};`}></div>
                      </div>
                      <span class="font-bold text-sm w-12 text-right" style={`color: ${getRiskColor(c.riskScore)};`}>
                        {c.riskScore.toFixed(1)}
                      </span>
                    </div>
                    <div class="text-xs mt-1" style={`color: ${getRiskColor(c.riskScore)}; opacity: 0.8;`}>{c.riskLabel}</div>
                  </td>
                  <td class="py-4 px-3">
                    <span class="text-slate-300 text-xs leading-relaxed">{c.bestFor}</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- 移动端：卡片式 -->
      <div class="md:hidden grid grid-cols-1 gap-4">
        {countries.map((c) => (
          <a href={c.href} class="country-card rounded-xl p-4 card-hover block">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl">{c.flag}</span>
              <div>
                <div class="font-bold text-white">{c.name}</div>
                <div class="text-xs text-slate-400">{c.bestFor}</div>
              </div>
              <div class="ml-auto text-right">
                <div class="font-bold text-lg" style={`color: ${getRiskColor(c.riskScore)};`}>{c.riskScore.toFixed(1)}</div>
                <div class="text-xs" style={`color: ${getRiskColor(c.riskScore)}; opacity: 0.8;`}>{c.riskLabel}</div>
              </div>
            </div>
            <div class="risk-bar">
              <div class="risk-fill" style={`width: ${Math.min(c.riskScore / 10 * 100, 100)}%; background: ${getRiskColor(c.riskScore)};`}></div>
            </div>
            <div class="grid grid-cols-3 gap-2 mt-3 text-center">
              <div><div class="text-white font-semibold text-sm">{c.gdp}</div><div class="text-slate-500 text-xs">亿美元GDP</div></div>
              <div><div class="text-emerald-400 font-semibold text-sm">{c.gdpGrowth}</div><div class="text-slate-500 text-xs">增速</div></div>
              <div><div class="text-white font-semibold text-sm">#{c.bizRank}</div><div class="text-slate-500 text-xs">营商排名</div></div>
            </div>
          </a>
