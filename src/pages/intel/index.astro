            <span>{ind.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== AI顾问入口 ====== -->
  <section class="py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="ai-box rounded-2xl p-8 md:p-12 text-center">
        <div class="text-5xl mb-6">🤖</div>
        <h2 class="text-2xl md:text-3xl font-bold mb-4 text-white">
          <span class="gradient-text">AI投资顾问</span>
        </h2>
        <p class="text-slate-400 mb-8 max-w-xl mx-auto leading-relaxed">
          不确定选哪个国家？不知道成本几何？AI顾问基于十一国结构化数据，实时为您分析并给出建议。覆盖政策、市场、风险、审批全维度。
        </p>

        <!-- 快捷问题按钮 -->
        <div class="flex flex-wrap justify-center gap-3 mb-8">
          {aiQuickQuestions.map(q => (
            <button
              id="ai-consultant-btn"
              data-question={q}
              class="ai-quick-btn rounded-full px-5 py-2.5 text-sm font-medium text-slate-300 cursor-pointer"
            >
              {q}
            </button>
          ))}
        </div>

        <a
          href="/intel/ai"
          id="ai-consultant-btn"
          class="btn-pill inline-flex items-center gap-3 px-8 py-4 btn-gold text-white font-bold text-lg"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
          立即向AI顾问提问
        </a>

        <p class="text-slate-600 text-xs mt-4">基于 STANDERRA 十一国结构化知识库 · 实时推理</p>
      </div>
    </div>
  </section>

  <!-- ====== 底部导航 ====== -->
  <section class="py-16 px-6" style="background: rgba(15, 23, 42, 0.5);">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/intel/compare/" class="bg-slate-800/60 rounded-xl p-6 card-hover block border border-slate-700/30">
          <div class="text-3xl mb-3">📊</div>
          <h3 class="text-white font-bold text-lg mb-2">国家情报</h3>
          <p class="text-slate-400 text-sm">深入了解每个国家的政治、经济、营商环境</p>
        </a>
        <a href="/intel/opportunities" class="bg-slate-800/60 rounded-xl p-6 card-hover block border border-slate-700/30">
          <div class="text-3xl mb-3">📦</div>
          <h3 class="text-white font-bold text-lg mb-2">方案包市场</h3>
          <p class="text-slate-400 text-sm">从工厂选址到成本测算，可直接使用的方案包</p>
        </a>
        <a href="/intel/pricing" class="bg-slate-800/60 rounded-xl p-6 card-hover block border border-slate-700/30">
          <div class="text-3xl mb-3">💎</div>
          <h3 class="text-white font-bold text-lg mb-2">订阅方案</h3>
          <p class="text-slate-400 text-sm">解锁完整情报和深度报告，加入情报网络</p>
        </a>
      </div>
    </div>
  </section>
</IntelLayout>
