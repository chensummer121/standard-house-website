---

<BaseLayout title="投资机会精选 - STANDERRA Intelligence" pageContext="opportunities">
  <style>
    .gradient-text {
      background: linear-gradient(135deg, #38bdf8, #0ea5e9);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .card-hover {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card-hover:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(56, 189, 248, 0.1);
    }
    
    .btn-gold {
      background: linear-gradient(135deg, #F59E0B, #D97706);
      transition: all 0.3s ease;
    }
    .btn-gold:hover {
      background: linear-gradient(135deg, #FBBF24, #F59E0B);
      box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
      transform: translateY(-2px);
    }
    
    .btn-pill {
      border-radius: 9999px;
    }
    
    .package-card {
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid rgba(148, 163, 184, 0.1);
    }
    
    .category-btn {
      transition: all 0.2s ease;
    }
    .category-btn:hover {
      background: rgba(56, 189, 248, 0.1);
      border-color: rgba(56, 189, 248, 0.4);
    }
    .category-btn.active {
      background: rgba(56, 189, 248, 0.2);
      border-color: #38bdf8;
      color: #38bdf8;
    }
  </style>

  <!-- 页面头部 -->
  <section class="pt-28 pb-12 px-6 bg-gradient-to-b from-slate-900/80 to-transparent">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        <span class="gradient-text">投资机会精选</span>
      </h1>
      <p class="text-xl text-slate-400 max-w-2xl">
        29个微工厂方案包，从¥880到¥2,980，覆盖建筑全产业链
      </p>
    </div>
  </section>

  <!-- 分类标签 -->
  <section class="py-6 px-6 sticky top-16 z-40 bg-slate-900/95 backdrop-blur-lg border-b border-slate-800">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap gap-3 justify-center">
        {categories.map((cat) => (
          <button 
            class={`category-btn px-4 py-2 rounded-full border border-slate-700 text-slate-300 text-sm font-medium ${cat === '全部' ? 'active' : ''}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- 方案包网格 -->
  <section class="py-12 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="packages-grid">
        {packages.map((pkg) => (
          <a href={pkg.href} class="package-card rounded-2xl overflow-hidden card-hover block" data-category={pkg.category}>
            <div class="h-32 bg-gradient-to-br from-sky-500/20 to-blue-600/20 flex items-center justify-center relative">
              <div class="absolute top-4 left-4 px-3 py-1 rounded-full text-white text-xs font-bold" style={`background: ${pkg.tagColor}`}>
                {pkg.tag}
              </div>
              <svg class="w-16 h-16 text-sky-400/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
              </svg>
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-2">
                <span class="px-2 py-0.5 rounded text-xs bg-slate-700 text-slate-400">{pkg.category}</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{pkg.name}</h3>
              <p class="text-slate-400 text-sm mb-4 line-clamp-2">{pkg.description}</p>
              <div class="flex items-center justify-between pt-3 border-t border-slate-700/50">
                <span class="text-xl font-bold text-white">{pkg.price}</span>
                <span class="text-sky-400 text-sm font-medium">查看详情 →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    const categoryBtns = document.querySelectorAll('.category-btn');
    const packageCards = document.querySelectorAll('#packages-grid a');
    
    categoryBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        categoryBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        
        const category = this.getAttribute('data-category');
        
        packageCards.forEach(card => {
          if (category === '全部' || card.getAttribute('data-category') === category) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
