---
import BaseLayout from '../../layouts/IntelLayout.astro';

const plans = [
  {
    name: '情报探索者',
    price: '免费',
    period: '',
    badge: '',
    description: '适合初步了解东非投资市场',
    features: [
      { text: '11国投资情报浏览', included: true },
      { text: 'AI顾问基础咨询', included: true },
      { text: '每周情报摘要推送', included: true },
      { text: '方案包市场浏览', included: true },
    ],
    cta: '立即加入',
    ctaStyle: 'outline',
    popular: false,
    note: '',
  },
  {
    name: '专业投资者',
    price: '¥99/月',
    period: '即将开放',
    badge: '即将开放',
    description: '适合认真评估东非投资机会',
    features: [
      { text: '全部探索者功能', included: true },
      { text: '深度报告无限阅读', included: true },
      { text: 'AI顾问深度分析', included: true },
      { text: '数据仪表板定制', included: true },
      { text: '投资机会优先推送', included: true },
    ],
    cta: '预约早期名额',
    ctaStyle: 'gold',
    popular: true,
    note: '早期成员享首年8折',
  },
  {
    name: '企业定制',
    price: '联系我们',
    period: '',
    badge: '',
    description: '适合机构投资和深度尽调',
    features: [
      { text: '全部专业版功能', included: true },
      { text: '定制化情报服务', included: true },
      { text: '数据API接入', included: true },
      { text: '专属客户经理', included: true },
      { text: '多人团队协作', included: true },
    ],
    cta: '联系我们',
    ctaStyle: 'outline',
    popular: false,
    note: '',
  },
];

const faqs = [
  {
    q: '现在注册收费吗？',
    a: '不收费，开发阶段完全免费。我们希望让更多人先体验产品价值。',
  },
  {
    q: '专业版什么时候开放？',
    a: '我们正在打磨体验，开放时会第一时间通知预约用户。留下邮箱，早知道早优惠。',
  },
  {
    q: '早期成员特权有什么？',
    a: '专业版首年8折、优先获取独家情报、早期成员专属标识、直接影响产品功能方向。',
  },
  {
    q: '企业定制怎么联系？',
    a: '发邮件到 standradhouseug@standard-house.com，我们会在24小时内回复。',
  },
];
---

<BaseLayout title="加入情报网络 - STANDERRA Intelligence" pageContext="pricing">
  <style>
    .gradient-text {
      background: linear-gradient(135deg, #38bdf8, #0ea5e9);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .btn-gold {
      background: linear-gradient(135deg, #F59E0B, #D97706);
      transition: all 0.3s ease;
    }
    .btn-gold:hover {
      background: linear-gradient(135deg, #FBBF24, #F59E0B);
      box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
      transform: translateY(-2px);
    }
    
    .btn-pill {
      border-radius: 9999px;
    }
    
    .plan-card {
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid rgba(148, 163, 184, 0.1);
      transition: all 0.3s ease;
    }
    .plan-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
    }
    .plan-card.popular {
      border-color: rgba(245, 158, 11, 0.5);
      background: linear-gradient(180deg, rgba(245, 158, 11, 0.1) 0%, rgba(30, 41, 59, 0.9) 100%);
    }
    
    .badge-soon {
      background: linear-gradient(135deg, #F59E0B, #D97706);
      color: white;
    }
    
    .faq-item {
      border-bottom: 1px solid rgba(148, 163, 184, 0.1);
    }
    
    .early-perks {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(59, 130, 246, 0.1));
      border: 1px solid rgba(245, 158, 11, 0.3);
    }
  </style>

  <!-- Hero区 -->
  <section class="pt-28 pb-12 px-6 bg-gradient-to-b from-slate-900/80 to-transparent">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        <span class="gradient-text">加入STANDERRA情报网络</span>
      </h1>
      <p class="text-xl text-slate-400 mb-6">
        东非投资情报，先行者先得。现在加入，享受早期成员专属特权。
      </p>
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 text-emerald-400 text-sm font-medium">
        <span>✓</span>
        <span>现在注册完全免费</span>
      </div>
    </div>
  </section>

  <!-- 定价卡片 -->
  <section class="py-12 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {plans.map((plan) => (
          <div class={`plan-card rounded-2xl p-8 ${plan.popular ? 'popular' : ''}`}>
            {plan.badge && (
              <div class="text-center mb-4">
                <span class="inline-block px-4 py-1 rounded-full badge-soon text-sm font-semibold">
                  {plan.badge}
                </span>
              </div>
            )}
            
            <div class="text-center mb-6">
              <h3 class="text-2xl font-bold text-white mb-2">{plan.name}</h3>
              <p class="text-slate-400 text-sm">{plan.description}</p>
            </div>
            
            <div class="text-center mb-6">
              <div class="flex flex-col items-center gap-1">
                <span class="text-4xl font-bold text-white">{plan.price}</span>
                {plan.period && <span class="text-amber-400 text-sm">{plan.period}</span>}
              </div>
            </div>
            
            {plan.note && (
              <div class="text-center mb-6">
                <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-sm font-medium">
                  🎁 {plan.note}
                </span>
              </div>
            )}
            
            <ul class="space-y-4 mb-8">
              {plan.features.map((feature) => (
                <li class="flex items-center gap-3">
                  <span class="text-emerald-400 text-lg">✓</span>
                  <span class="text-slate-300">{feature.text}</span>
                </li>
              ))}
            </ul>
            
            {plan.name === '企业定制' ? (
              <a 
                href="mailto:standradhouseug@standard-house.com" 
                class={`block text-center py-3 rounded-full font-semibold transition-all ${
                  plan.ctaStyle === 'gold' 
                    ? 'btn-pill btn-gold text-white' 
                    : 'border-2 border-slate-600 text-slate-300 hover:border-sky-500 hover:text-sky-400'
                }`}
              >
                {plan.cta}
              </a>
            ) : plan.name === '专业投资者' ? (
              <a 
                href="#waitlist" 
                class="block text-center py-3 rounded-full font-semibold transition-all btn-pill btn-gold text-white"
              >
                {plan.cta}
              </a>
            ) : (
              <a 
                href="#register" 
                class={`block text-center py-3 rounded-full font-semibold transition-all ${
                  plan.ctaStyle === 'gold' 
                    ? 'btn-pill btn-gold text-white' 
                    : 'border-2 border-slate-600 text-slate-300 hover:border-sky-500 hover:text-sky-400'
                }`}
              >
                {plan.cta}
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 早期成员特权横幅 -->
  <section class="py-8 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="early-perks rounded-2xl p-8 text-center">
        <h2 class="text-2xl font-bold mb-4 text-white">
          🎯 早期成员特权
        </h2>
        <p class="text-slate-300 mb-6">
          现在注册的探索者和预约专业版的成员，将在正式付费版上线时享受：
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left max-w-2xl mx-auto">
          <div class="flex items-start gap-3">
            <span class="text-amber-400 text-xl">✦</span>
            <div>
              <span class="text-white font-semibold">专业版首年8折</span>
              <p class="text-slate-400 text-sm">锁定优惠价格，放心投资</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-amber-400 text-xl">✦</span>
            <div>
              <span class="text-white font-semibold">优先获取独家情报</span>
              <p class="text-slate-400 text-sm">比其他人更早看到机会</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-amber-400 text-xl">✦</span>
            <div>
              <span class="text-white font-semibold">早期成员专属标识</span>
              <p class="text-slate-400 text-sm">尊贵的早期支持者身份</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-amber-400 text-xl">✦</span>
            <div>
              <span class="text-white font-semibold">直接影响产品方向</span>
              <p class="text-slate-400 text-sm">您的意见塑造我们的服务</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 px-6 bg-slate-900/50">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-8 text-center">
        <span class="gradient-text">常见问题</span>
      </h2>
      
      <div class="space-y-0">
        {faqs.map((faq) => (
          <div class="faq-item py-6">
            <h3 class="text-lg font-semibold text-white mb-3">{faq.q}</h3>
            <p class="text-slate-400">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 底部CTA -->
  <section class="py-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-bold mb-4">
        <span class="gradient-text">准备好加入了？</span>
      </h2>
      <p class="text-slate-400 mb-8">
        无论您选择哪种方式，我们都期待您的加入
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#register" class="btn-pill px-8 py-4 btn-gold text-white font-bold text-lg shadow-xl inline-block">
          免费加入 →
        </a>
        <a href="mailto:standradhouseug@standard-house.com" class="btn-pill px-8 py-4 border-2 border-slate-600 text-slate-300 hover:border-sky-500 hover:text-sky-400 font-bold text-lg inline-block">
          企业咨询
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
