---
import BuildLayout from '../layouts/BuildLayout.astro';

const featuredHouses = [
  {
    id: "1",
    name: "Model A",
    image: "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=800&q=80",
    bedrooms: 2,
    bathrooms: 1,
    area: 72,
    badge: "Economy",
    price: "UGX 200M",
    description: "Prefabricated steel structure, 65-80㎡"
  },
  {
    id: "2",
    name: "Model B",
    image: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&q=80",
    bedrooms: 3,
    bathrooms: 2,
    area: 135,
    badge: "Popular",
    price: "UGX 450M",
    description: "Standard BOM package, 45-day delivery"
  },
  {
    id: "3",
    name: "Model C",
    image: "https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=800&q=80",
    bedrooms: 4,
    bathrooms: 3,
    area: 300,
    badge: "Premium",
    price: "Custom Quote",
    description: "Modular customization, 200-400㎡"
  },
];

const values = [
  {
    title: "Standardized Floor Plans",
    description: "Our curated catalog of pre-designed homes lets you see your future home before breaking ground.",
    iconPath: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
  },
  {
    title: "Precise Material Package",
    description: "Every bolt, every beam accounted for. 100% transparent pricing with zero budget surprises.",
    iconPath: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
  },
  {
    title: "Guaranteed Timeline",
    description: "Modular construction management ensures on-time delivery. No endless delays.",
    iconPath: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
  },
];

const roleButtons = [
  { role: "Home Buyer", description: "Find your dream home", href: "/house-designs", iconPath: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" },
  { role: "Investor", description: "Explore ROI opportunities", href: "/investment", iconPath: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" },
  { role: "Builder", description: "Start your project", href: "/configurator", iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" },
  { role: "Partner", description: "Join our network", href: "/about#partners", iconPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" },
];
---

<BuildLayout title="Home" description="PropTech housing innovator in Uganda. Prefabricated homes with transparent pricing and guaranteed timelines.">
  
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1920&q=80"
        alt="Modern prefabricated home in Uganda"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-earth-900/80 via-earth-900/60 to-transparent"></div>
    </div>

    <!-- Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Build with Confidence, <span class="text-primary">Build with Standards</span>
        </h1>
        <p class="text-lg md:text-xl text-earth-100 mb-8">
          From blueprint to keys — prefabricated homes with transparent pricing and guaranteed timelines.
        </p>

        <!-- I want to... buttons -->
        <div class="mb-12">
          <p class="text-primary font-medium mb-4">I want to...</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {roleButtons.map((item) => (
              <a
                href={item.href}
                class="group flex flex-col items-center p-4 bg-white/10 backdrop-blur-sm rounded-xl border border-white/20 hover:bg-white hover:text-earth-800 transition-all duration-300"
              >
                <svg class="h-8 w-8 mb-2 text-primary group-hover:text-earth-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.iconPath} />
                </svg>
                <span class="font-semibold text-sm">{item.role}</span>
                <span class="text-xs text-earth-300 group-hover:text-earth-600 text-center mt-1">
                  {item.description}
                </span>
              </a>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <div class="flex flex-wrap gap-4">
          <a href="/configurator" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-amber-600 transition-colors">
            Start Your Journey
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/house-designs" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-white text-white font-medium rounded-lg hover:bg-white hover:text-earth-800 transition-colors">
            Browse Designs
          </a>
          <a href="#" id="ai-consultant-btn" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-amber-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            AI Consultant
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
      <div class="w-6 h-10 border-2 border-white/50 rounded-full flex items-start justify-center p-2">
        <div class="w-1.5 h-3 bg-white rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- Core Values Section -->
  <section class="py-16 md:py-24 bg-earth-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-primary font-medium">Why Choose Us</span>
        <h2 class="text-3xl md:text-4xl font-bold text-earth-800 mt-2 mb-4">PropTech Innovation in Uganda</h2>
        <p class="text-earth-600">
          We combine prefabricated technology with transparent pricing to redefine how Africa builds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((value) => (
          <div class="group p-8 bg-white rounded-2xl shadow-md hover:shadow-lg transition-all duration-300 border border-earth-100">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-primary/20 to-earth-200 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="h-7 w-7 text-earth-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={value.iconPath} />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-earth-800 mb-3">
              {value.title}
            </h3>
            <p class="text-earth-600 leading-relaxed">
              {value.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Houses Section -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
        <div>
          <span class="text-primary font-medium">Product Models</span>
          <h2 class="text-3xl md:text-4xl font-bold text-earth-800 mt-2">Featured Designs</h2>
          <p class="text-earth-600 mt-2 max-w-xl">
            Choose from our standardized catalog. See exactly what you get — no surprises.
          </p>
        </div>
        <a
          href="/house-designs"
          class="inline-flex items-center gap-2 text-primary font-medium hover:text-earth-700 transition-colors"
        >
          View All Designs
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredHouses.map((house) => (
          <div class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300">
            <!-- Image -->
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={house.image}
                alt={house.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              {house.badge && (
                <span class="absolute top-4 left-4 px-3 py-1 bg-primary text-white text-xs font-medium rounded-full">
                  {house.badge}
                </span>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>

            <!-- Content -->
            <div class="p-5">
              <h3 class="text-xl font-semibold text-earth-800 mb-3">
                {house.name}
              </h3>

              <!-- Stats -->
              <div class="flex items-center gap-4 text-sm text-earth-600 mb-4">
                <div class="flex items-center gap-1">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                  <span>{house.bedrooms} Beds</span>
                </div>
                <div class="flex items-center gap-1">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                  </svg>
                  <span>{house.bathrooms} Baths</span>
                </div>
                <div class="flex items-center gap-1">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                  </svg>
                  <span>{house.area} m²</span>
                </div>
              </div>

              <!-- Footer -->
              <div class="flex items-center justify-between pt-4 border-t border-earth-100">
                {house.price && (
                  <span class="text-lg font-bold text-primary">{house.price}</span>
                )}
                <a
                  href="/configurator"
                  class="ml-auto flex items-center gap-1 text-sm font-medium text-earth-700 hover:text-primary transition-colors"
                >
                  Configure
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Badges Section -->
  <section class="py-16 md:py-24 bg-sage-800 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl md:text-5xl font-bold text-primary mb-2">500+</div>
          <div class="text-sage-200">Homes Built</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold text-primary mb-2">15+</div>
          <div class="text-sage-200">Years Experience</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold text-primary mb-2">98%</div>
          <div class="text-sage-200">Client Satisfaction</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold text-primary mb-2">12</div>
          <div class="text-sage-200">African Countries</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-earth-100 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <img
        src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1920&q=80"
        alt=""
        class="w-full h-full object-cover"
      />
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-earth-800 mb-6">Ready to Build Your Dream Home?</h2>
        <p class="text-earth-600 mb-8">
          Let our AI assistant help you design the perfect home. Answer a few questions 
          and get a personalized recommendation in minutes.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/configurator" class="inline-flex items-center gap-2 text-lg px-8 py-4 bg-primary text-white font-medium rounded-lg hover:bg-amber-600 transition-colors">
            Start Configurator
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/investment" class="inline-flex items-center gap-2 text-lg px-8 py-4 bg-earth-800 text-white font-medium rounded-lg hover:bg-earth-700 transition-colors">
            Investment Opportunities
          </a>
        </div>
      </div>
    </div>
  </section>

</BuildLayout>
