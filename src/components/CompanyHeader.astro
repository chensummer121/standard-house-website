---
const navItems = [
  { name: '首页', href: '/' },
  { name: '项目展示', href: '/projects' },
  { name: '侨民代建', href: '/diaspora' },
  { name: '微工厂', href: '/micro-factory' },
  { name: '关于我们', href: '/about' },
  { name: '联系方式', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm shadow-sm">
  <nav class="container-custom">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center text-xl font-bold" style="background: linear-gradient(135deg, #1E3A5F, #F59E0B);">
          <span class="text-white">S</span>
        </div>
        <span class="font-display font-bold text-lg hidden md:inline">
          <span style="color: #1E3A5F;">Standard</span>
          <span style="color: #F59E0B;">House</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        {navItems.map(item => (
          <a 
            href={item.href}
            class={`text-sm font-medium transition-colors ${
              currentPath === item.href 
                ? 'text-[#F59E0B]' 
                : 'text-gray-600 hover:text-[#1E3A5F]'
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- Right Actions -->
      <div class="flex items-center gap-4">
        <a 
          href="https://wa.me/256766969867" 
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-colors text-white"
          style="background: linear-gradient(135deg, #F59E0B, #d97706);"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-gray-600 hover:text-[#1E3A5F]">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden pb-4">
      <div class="flex flex-col gap-2">
        {navItems.map(item => (
          <a 
            href={item.href}
            class={`px-3 py-2 text-sm font-medium rounded-lg ${
              currentPath === item.href 
                ? 'bg-[#F59E0B]/10 text-[#F59E0B]' 
                : 'text-gray-600 hover:bg-gray-100'
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
