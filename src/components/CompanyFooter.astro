---
const currentYear = new Date().getFullYear();

const exploreLinks = [
  { name: '项目展示', href: '/projects' },
  { name: '侨民代建', href: '/diaspora' },
  { name: '微工厂方案', href: '/micro-factory' },
];

const companyLinks = [
  { name: '关于我们', href: '/about' },
  { name: '联系方式', href: '/contact' },
];

const resourceLinks = [
  { name: '投资情报系统', href: '/intel' },
  { name: '水泥地图', href: '/cement-map.html' },
];
---

<footer style="background: #1E3A5F; color: white;">
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center text-xl font-bold" style="background: linear-gradient(135deg, #F59E0B, #d97706);">
            <span class="text-white">S</span>
          </div>
          <span class="font-display font-bold text-lg">
            <span style="color: white;">Standard</span>
            <span style="color: #F59E0B;">House</span>
          </span>
        </a>
        <p class="text-gray-300 text-sm mb-6">
          乌干达装配式建筑一站式服务。让建造像组装电脑一样简单。
        </p>
        <div class="flex gap-4">
          <a href="https://wa.me/256766969867" target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#F59E0B] transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-semibold text-lg mb-4" style="color: #F59E0B;">核心服务</h3>
        <ul class="space-y-3">
          {exploreLinks.map(link => (
            <li>
              <a href={link.href} class="text-gray-300 hover:text-white text-sm transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="font-semibold text-lg mb-4" style="color: #F59E0B;">关于我们</h3>
        <ul class="space-y-3">
          {companyLinks.map(link => (
            <li>
              <a href={link.href} class="text-gray-300 hover:text-white text-sm transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="font-semibold text-lg mb-4" style="color: #F59E0B;">数据资源</h3>
        <ul class="space-y-3">
          {resourceLinks.map(link => (
            <li>
              <a href={link.href} class="text-gray-300 hover:text-white text-sm transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/20 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 text-sm">
        © {currentYear} Standard House. All rights reserved.
      </p>
      <p class="text-gray-400 text-sm">
        STANDERRA HOUSING TECHNOLOGY LTD | Reg: 80034420750743
      </p>
    </div>
  </div>
</footer>
