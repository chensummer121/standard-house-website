---
interface Props {
  code: string;
  name: string;
  flag: string;
  description: string;
}

const { code, name, flag, description } = Astro.props;
---

<a 
  href={`/invest/${code}`}
  class="group block bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-100"
>
  <div class="p-6">
    <div class="flex items-center space-x-4 mb-4">
      <span class="text-5xl">{flag}</span>
      <div>
        <h3 class="text-xl font-bold text-gray-900 group-hover:text-secondary transition-colors">
          {name}
        </h3>
        <p class="text-sm text-gray-500 uppercase tracking-wider">{code}</p>
      </div>
    </div>
    <p class="text-gray-600 text-sm leading-relaxed">
      {description}
    </p>
    <div class="mt-4 flex items-center text-secondary font-medium text-sm">
      <span>进入数据库</span>
      <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</a>
